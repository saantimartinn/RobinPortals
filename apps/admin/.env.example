VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# CRM: altas en la base independiente de Robin Jr.
ROBIN_JR_SUPABASE_URL=your_robin_jr_supabase_url
ROBIN_JR_SUPABASE_SERVICE_ROLE_KEY=your_robin_jr_service_role_key
# CRM: altas en la base independiente de Community.
ROBIN_PLAN_SUPABASE_URL=your_community_supabase_url
ROBIN_PLAN_SUPABASE_SERVICE_ROLE_KEY=your_community_service_role_key
# Contraseña inicial de las cuentas creadas al convertir un lead en el CRM.
CRM_BOOTSTRAP_PASSWORD=your_client_bootstrap_password

# Holded analytics (Netlify Functions)
HOLDED_API_KEY=your_holded_v1_api_key
HOLDED_API_PAT=your_holded_v2_pat
# Opcional: key del impuesto de venta exento (0 %) en Holded. Si queda vacío,
# la integración intenta descubrirlo automáticamente mediante la API de impuestos.
HOLDED_TAX_EXEMPT=

# Comma-separated Holded account numbers or internal account IDs.
# Defaults from lib/finance-dashboard.js remain active and these values extend them.
HOLDED_EXPENSE_ACCOUNTS_OPERATIONAL=
HOLDED_EXPENSE_ACCOUNTS_MARKETING=
HOLDED_EXPENSE_ACCOUNTS_OTHER=
HOLDED_EXPENSE_ACCOUNTS_CAPEX=
